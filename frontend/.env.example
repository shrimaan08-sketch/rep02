# ============================================================================
# Revion frontend configuration
# ----------------------------------------------------------------------------
# IMPORTANT: Next.js inlines NEXT_PUBLIC_* variables into the client bundle at
# BUILD time — they are baked in when `npm run build` runs, not read at
# runtime. Consequences:
#   * Local docker-compose passes this as a build ARG (see docker-compose.yml).
#   * On Render, set it as an environment variable on the frontend service so
#     it's present during the build. If you change it later, you must trigger
#     a rebuild/redeploy for the change to take effect.
# ============================================================================

# Full base URL of the backend API, INCLUDING the /api/v1 prefix.
#   Local:      http://localhost:8000/api/v1
#   On Render:  https://<your-backend-service>.onrender.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Optional: run the UI against an in-browser mock backend (no real API needed).
# Leave false for normal operation against the real backend above.
NEXT_PUBLIC_DEMO_MODE=false
