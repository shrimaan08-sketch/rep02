ENVIRONMENT=development
DEBUG=true

SECRET_KEY=super-secret-key-replace-in-production-with-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

POSTGRES_USER=eco_user
POSTGRES_PASSWORD=eco_password
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_DB=eco_platform

REDIS_URL=redis://redis:6379/0

BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# Email - set EMAIL_ENABLED=true and fill in real SMTP creds to send real mail.
# Until then, outgoing emails are logged instead of sent.
EMAIL_ENABLED=false
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=eco-platform@example.com
SMTP_TLS=true

# AI summaries - set a real key to enable AI-generated ECR/ECO summaries.
# Leaving this blank disables the feature gracefully (no errors, just no summary).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

UPLOAD_DIR=/app/storage/documents
MAX_UPLOAD_SIZE_MB=25
