# Root-level environment for docker-compose. Copy to `.env` and adjust.
# Backend application secrets live separately in backend/.env (copy from
# backend/.env.example); docker-compose loads that via `env_file`.

# --- PostgreSQL (used by the postgres service + assembled into DATABASE_URL) ---
POSTGRES_USER=revion_user
POSTGRES_PASSWORD=revion_password
POSTGRES_DB=revion

# --- Backend runtime toggles passed through by docker-compose ---
# development | production. Use development locally.
ENVIRONMENT=development
# Seed an admin (and demo data) on first boot. Idempotent.
SEED_ON_STARTUP=true
# Allowed browser origins for the API (the frontend URL).
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- Frontend (BUILD-TIME) ---
# Must be reachable from the *browser*, not just inside the Docker network,
# because Next.js bakes NEXT_PUBLIC_* into the client bundle at build time.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
