# This file makes the app run in "live demo" mode out of the box: a
# client-side mock backend simulates the real FastAPI service (same state
# machines, same approval-chain logic) so you can click around with zero
# setup -- no Docker, no Postgres, no Redis needed.
#
# To connect this frontend to your REAL backend instead (the actual
# FastAPI + Postgres + Redis stack from docker-compose.yml), delete this
# file, or set NEXT_PUBLIC_DEMO_MODE=false and point NEXT_PUBLIC_API_URL at
# your running backend.
NEXT_PUBLIC_DEMO_MODE=true
