# ============================================================================
# Revion backend configuration
# ----------------------------------------------------------------------------
# Copy to `.env` for local docker-compose. On Render, set these as the
# service's Environment Variables instead (do NOT commit a real .env).
# Every variable the backend reads is listed here.
# ============================================================================

# --- Core -------------------------------------------------------------------
# development | staging | production. In production, the app refuses to start
# with an insecure/short SECRET_KEY or a missing DATABASE_URL.
ENVIRONMENT=development
# Extra API logging / verbose errors. Keep false in production.
DEBUG=false
# ASGI bind port. Render injects PORT automatically — you normally do NOT set
# this yourself on Render. Locally it defaults to 8000.
PORT=8000
# Number of uvicorn workers (read by the entrypoint, not pydantic). 2 is a
# good default for Render's smaller instances.
UVICORN_WORKERS=2

# --- Security ---------------------------------------------------------------
# REQUIRED in production. Generate with e.g. `openssl rand -hex 32`.
# Must be >= 32 chars and not one of the known placeholder values.
SECRET_KEY=replace-with-a-long-random-string-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# --- Database ---------------------------------------------------------------
# PREFERRED: a single connection string. This is exactly what Render's managed
# Postgres gives you (Internal Database URL). The app accepts the plain
# `postgresql://` form and derives the async (asyncpg) and sync (psycopg2)
# drivers itself — you do NOT need to add "+asyncpg". The legacy "postgres://"
# scheme is also normalized automatically.
DATABASE_URL=postgresql://revion_user:revion_password@localhost:5432/revion
#
# FALLBACK (used only if DATABASE_URL is empty): discrete parts, handy for
# local docker-compose where the DB host is the "postgres" service.
POSTGRES_USER=revion_user
POSTGRES_PASSWORD=revion_password
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_DB=revion

# --- Redis (OPTIONAL) -------------------------------------------------------
# Used for login rate-limiting and dashboard caching. If unset, the app runs
# fine without it (fail-open). On Render, set this to your Redis instance's
# Internal URL if you add one; otherwise leave it blank.
REDIS_URL=redis://redis:6379/0

# --- CORS -------------------------------------------------------------------
# Comma-separated list (or a JSON array) of allowed browser origins. In
# production this MUST include your deployed frontend URL, e.g.:
#   BACKEND_CORS_ORIGINS=https://revion-web.onrender.com
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- Startup / seeding ------------------------------------------------------
# After migrations, seed an initial admin (idempotent). Safe to leave true.
SEED_ON_STARTUP=true
# Override the seeded admin so production doesn't use the demo default.
SEED_ADMIN_EMAIL=admin@revion.app
SEED_ADMIN_PASSWORD=ChangeMe123!
# Whether to also seed the 5 demo role accounts + demo parts. Set false for a
# clean production database with only your admin account.
SEED_DEMO_ACCOUNTS=true

# --- Email (OPTIONAL, SMTP) -------------------------------------------------
# When EMAIL_ENABLED=false, notification emails are logged instead of sent, so
# the app works with no mail server. Fill these and flip the flag to send real
# supplier/approval notifications.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@revion.app
SMTP_TLS=true

# --- AI summaries (OPTIONAL, Anthropic) -------------------------------------
# If set, ECRs/ECOs get an AI-generated plain-English summary on creation.
# If blank, that feature is silently disabled and nothing breaks.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- File storage -----------------------------------------------------------
# Where uploaded documents / generated QR+barcode images are written. On
# Render's ephemeral filesystem this resets on redeploy; attach a Render Disk
# mounted here if you need uploads to persist.
UPLOAD_DIR=/app/storage/documents
MAX_UPLOAD_SIZE_MB=25
